<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.FcitxAppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nothing_surface</item>
        <item name="colorPrimaryDark">@color/nothing_surface</item>
        <item name="colorAccent">@color/nothing_accent</item>
        <item name="android:colorAccent">@color/nothing_accent</item>
        <item name="android:windowBackground">@color/nothing_surface</item>
        <item name="android:statusBarColor">@color/nothing_surface</item>
        <item name="android:navigationBarColor">@color/nothing_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/nothing_content</item>
        <item name="android:textColorSecondary">@color/nothing_secondary_content</item>
        <item name="android:fontFamily">@font/doto</item>
        <item name="fontFamily">@font/doto</item>
        <item name="colorControlNormal">@color/nothing_secondary_content</item>
        <item name="colorControlActivated">@color/nothing_accent</item>
        <item name="colorLogFatal">@color/red_A700</item>
        <item name="colorLogError">@color/red_400</item>
        <item name="colorLogWarning">@color/yellow_500</item>
        <item name="colorLogInfo">@color/blue_500</item>
        <item name="colorLogDebug">@color/grey_400</item>
        <item name="colorLogVerbose">@color/grey_400</item>
    </style>

    <style name="TextAppearance.Nothing.SettingsToolbar" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:fontFamily">@font/doto</item>
        <item name="fontFamily">@font/doto</item>
        <item name="android:textColor">@color/nothing_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Theme.DialogTheme" parent="@android:style/Theme.DeviceDefault.Dialog" />

    <style name="InputViewSnackbarTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar" />
</resources>
